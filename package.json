{
  "name": "lung-client",
  "version": "20.0.0",
  "description": "Lung client",
  "license": "Apache-2.0",
  "keywords": [
    "helgoland",
    "angular",
    "webpack",
    "typescript"
  ],
  "author": {
    "name": "Jan Schulte"
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/52North/lung-client.git"
  },
  "bugs": {
    "url": "https://github.com/52North/lung-client/issues"
  },
  "homepage": "https://github.com/52North/lung-client#readme",
  "workspaces": [
    "projects/**"
  ],
  "scripts": {
    "a11y": "node a11y/run.mjs",
    "build:client": "ng build lung-client",
    "lint": "ng lint",
    "license-report": "license-report --output=json --config license/license-report-config.json > license/license-report.json && tablemark license/license-report.json > license/license-report.md && rm license/license-report.json",
    "ng": "ng",
    "start": "ng serve",
    "prestart": "npm run versions-script",
    "sbom": "node scripts/sbom.js",
    "versions-script": "node scripts/git.version.js",
    "i18n": "ngx-translate-extract --input ./src --output ./src/assets/i18n/*.json --clean --format --sort",
    "list-versions": "syncpack list-mismatches",
    "update-versions": "syncpack fix-mismatches"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.6",
    "@angular/cdk": "^20.0.5",
    "@angular/common": "^20.0.6",
    "@angular/compiler": "^20.0.6",
    "@angular/core": "^20.0.6",
    "@angular/forms": "^20.0.6",
    "@angular/material": "^20.0.5",
    "@angular/material-moment-adapter": "^20.0.5",
    "@angular/platform-browser": "^20.0.6",
    "@angular/platform-browser-dynamic": "^20.0.6",
    "@angular/router": "^20.0.6",
    "@helgoland/auth": "^20.0.1",
    "@helgoland/caching": "^20.0.1",
    "@helgoland/core": "^20.0.1",
    "@helgoland/d3": "^20.0.1",
    "@helgoland/depiction": "^20.0.1",
    "@helgoland/map": "^20.0.1",
    "@helgoland/selector": "^20.0.1",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "d3": "^7.8.5",
    "d3-delaunay": "^6.0.4",
    "keycloak-angular": "^20.0.0",
    "keycloak-js": "^26.2.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "material-icons": "^1.13.12",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.39",
    "ngx-clipboard": "^15.1.0",
    "ngx-color-picker": "^13.0.0",
    "roboto-fontface": "^0.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript-logging": "^0.6.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.1.1",
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular-eslint/eslint-plugin-template": "20.1.1",
    "@angular-eslint/schematics": "20.1.1",
    "@angular-eslint/template-parser": "20.1.1",
    "@angular/build": "^20.0.5",
    "@angular/cli": "^20.0.5",
    "@angular/compiler-cli": "^20.0.6",
    "@axe-core/playwright": "^4.11.0",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@types/d3": "^7.4.0",
    "@types/d3-delaunay": "^6.0.1",
    "@types/geojson": "^7946.0.10",
    "@types/leaflet": "^1.9.3",
    "@types/leaflet.markercluster": "^1.5.1",
    "@types/node": "^12.20.15",
    "@types/ol": "^5.3.5",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vendure/ngx-translate-extract": "^9.0.0",
    "archiver": "^5.3.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "license-report": "^6.3.0",
    "ng-packagr": "^20.0.1",
    "playwright": "^1.56.0",
    "prettier": "^3.1.1",
    "prettier-eslint": "^16.2.0",
    "syncpack": "11.2.1",
    "tablemark-cli": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
