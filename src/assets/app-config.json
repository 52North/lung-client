{
    "defaultService": {
        "serviceId": "1",
        "apiUrl": "https://mdpu.dev.52north.org/FROST-Server/v1.1/"
    },
    "datasetApis": [
        {
            "name": "https://mdpu.dev.52north.org/FROST-Server/v1.1/",
            "url": "https://mdpu.dev.52north.org/FROST-Server/v1.1/"
        }
    ],
    "languages": [
        {
            "label": "Deutsch",
            "code": "de"
        },
        {
            "label": "English",
            "code": "en"
        }
    ],
    "supportTimeseriesSymbols": true,
    "mapSelectionClusterConfig": {
        "maxClusterRadius": 60
    },
    "baseLayers": [
        {
            "label": "ORKa.MV",
            "visible": true,
            "type": "tilelayer",
            "urlTemplate": "https://www.orka-mv.de/geodienste/orkamv/tiles/1.0.0/orkamv/GLOBAL_WEBMERCATOR/{z}/{x}/{y}.png",
            "options": {
                "maxZoom": 19,
                "minZoom": 7,
                "attribution": "<a href=\"https://www.orka-mv.de//copyright\">Kartenbild &copy; Hanse- und Universitätsstadt Rostock (CC BY 4.0) | Kartendaten &copy; OpenStreetMap (ODbL) und LkKfS-MV</a>"
            }
        },
        {
            "label": "GDI-MV DOP WMS",
            "visible": false,
            "type": "wms",
            "url": " https://www.geodaten-mv.de/dienste/adv_dop?",
            "options": {
                "layers": "mv_dop",
                "format": "image/png",
                "transparent": true,
                "minZoom": 11,
                "attribution": "&copy; GeoBasis-DE/M-V 2025"
            }
        },
        {
            "label": "Luftbild MV (20 cm)",
            "visible": false,
            "type": "tilelayer",
            "urlTemplate": "https://geo.sv.rostock.de/geodienste/luftbild_mv-20/wmts/hro.luftbild_mv-20.luftbild_mv-20/GLOBAL_WEBMERCATOR/{z}/{x}/{y}.png",
            "options": {
                "maxZoom": 19,
                "minZoom": 10,
                "attribution": "&copy; GeoBasis-DE/M-V 2025"
            }
        },
        {
            "label": "Gebäude 2D",
            "visible": false,
            "type": "wms",
            "url": "https://www.geodaten-mv.de/dienste/gebaeude_wms?",
            "options": {
                "layers": "gebaeude",
                "format": "image/png",
                "transparent": true,
                "minZoom": 14,
                "attribution": "&copy; GeoBasis-DE/M-V 2025"
            }
        }
    ],
    "dataTableVisible": true,
    "keycloak": {
        "config": {
           "url": "https://mdpu.dev.52north.org/auth" ,
           "realm": "mdpu",
           "clientId": "lung-client"
        },
        "bearerTokenCondition": {
            "urlPattern": "^(http:\\/\\/mdpu.dev.52north.org)(\\/.*)?$",
            "bearerPrefix": "Bearer"
        }
    }
}