{
    "defaultService": {
        "serviceId": "1",
        "apiUrl": "https://umweltportal.mv-regierung.de/mdpu/FROST-Server/v1.1/"
    },
    "datasetApis": [
        {
            "name": "https://umweltportal.mv-regierung.de/mdpu/FROST-Server/v1.1/",
            "url": "https://umweltportal.mv-regierung.de/mdpu/FROST-Server/v1.1/",
            "connector": "LungStaApiConnector"
        }
    ],
    "languages": [
        {
            "label": "Deutsch",
            "code": "de"
        },
        {
            "label": "English",
            "code": "en"
        }
    ],
    "supportTimeseriesSymbols": true,
    "mapSelectionClusterConfig": {
        "maxClusterRadius": 60
    },
    "baseLayers": [
        {
            "label": "ORKa.MV",
            "visible": true,
            "type": "tilelayer",
            "urlTemplate": "https://www.orka-mv.de/geodienste/orkamv/tiles/1.0.0/orkamv/GLOBAL_WEBMERCATOR/{z}/{x}/{y}.png",
            "options": {
                "maxZoom": 19,
                "minZoom": 7,
                "attribution": "<a href=\"https://www.orka-mv.de//copyright\">Kartenbild &copy; Hanse- und Universitätsstadt Rostock (CC BY 4.0) | Kartendaten &copy; OpenStreetMap (ODbL) und LkKfS-MV</a>"
            }
        },
        {
            "label": "Luftbild MV (20 cm)",
            "visible": false,
            "type": "tilelayer",
            "urlTemplate": "https://geo.sv.rostock.de/geodienste/luftbild_mv-20/wmts/hro.luftbild_mv-20.luftbild_mv-20/GLOBAL_WEBMERCATOR/{z}/{x}/{y}.png",
            "options": {
                "maxZoom": 19,
                "minZoom": 10,
                "attribution": "&copy; GeoBasis-DE/M-V 2025"
            }
        }
    ],
    "dataTableVisible": true,
    "keycloak": {
        "config": {
           "url": "https://umweltportal.mv-regierung.de/mdpu/auth",
           "realm": "mdpu",
           "clientId": "lung-client"
        },
        "bearerTokenCondition": {
            "urlPattern": "^(https:\\/\\/umweltportal.mv-regierung.de)(\\/.*)?$",
            "bearerPrefix": "Bearer"
        },
        "adminGroup": "admin",
        "adminUrl": "https://umweltportal.mv-regierung.de/mdpu/auth/admin/mdpu/console/"
    }
}